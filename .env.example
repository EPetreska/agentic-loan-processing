# Copy this file to .env and fill in your values. .env is never committed.

# Which model runs the agent: "ollama:<name>" (local) or "anthropic:<name>".
LLM_MODEL=ollama:qwen3:4b

# Tracing with LangSmith (optional). Set LANGSMITH_TRACING=true once the key
# is filled in; LangGraph then sends the traces by itself.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-bpm-loans
