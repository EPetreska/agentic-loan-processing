# Copy this file to .env and adjust. .env is never committed.
# This file holds settings only. API keys are not kept here: they are read
# from the system keyring when a run starts (see KEYRING in src/loans/run.py).
# Store a key once with, for example:
#   secret-tool store --label="LangSmith API key" service langsmith account apikey
#   secret-tool store --label="Anthropic API key" service anthropic account apikey

# Which model runs the agent: "ollama:<name>" (local) or "anthropic:<name>".
LLM_MODEL=ollama:qwen3:4b

# Tracing with LangSmith. Needs the LangSmith key in the keyring; without it,
# runs go ahead with tracing off.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=agentic-bpm-loans

# The bank's application database (Postgres, started with docker compose; see
# docker-compose.yml). The password is not kept here: it is read from the
# keyring (service loans-postgres, account postgres).
DATABASE_URL=postgresql://loans@localhost:5432/loans

# The MCP server (start it with: uv run python -m loans.mcp.server).
MCP_URL=http://127.0.0.1:8000/mcp
